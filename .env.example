# Configuration de FreshRotten Guard — copiez ce fichier en .env et adaptez.
# Toutes les variables sont préfixées par FRG_. Aucun secret ne doit être commité.

# --- Authentification ---------------------------------------------------------
FRG_AUTHENTIFICATION=true
# Comptes : {"identifiant": "empreinte scrypt"} — générer avec : python scripts/creer_compte.py jury
FRG_COMPTES={}
# Clé de signature des jetons (64 caractères hexadécimaux aléatoires). Vide : générée au démarrage.
FRG_SECRET_SESSION=
FRG_DUREE_SESSION_MIN=480
FRG_LIMITE_CONNEXION=5/minute

# --- Modèle -------------------------------------------------------------------
FRG_MODELE_ACTIF=robuste
FRG_VERIFIER_EMPREINTES=true

# --- Fichiers -----------------------------------------------------------------
FRG_TAILLE_MAX_OCTETS=5242880
FRG_PIXELS_MAX=40000000
FRG_DIMENSION_MAX=8000

# --- Web ----------------------------------------------------------------------
FRG_ORIGINES_CORS=["http://localhost:5173","http://127.0.0.1:5173"]
FRG_LIMITE_ANALYSE=240/minute
FRG_LIMITE_COMPARER=60/minute
FRG_LIMITE_ATTAQUE=12/minute
FRG_DELAI_INFERENCE_S=15
FRG_FILE_MAX=8
FRG_DECIMALES_PROBABILITES=3
# Sel secret du hachage des IP dans les journaux. Absent : généré au démarrage.
FRG_SEL_HACHAGE_IP=

# Les seuils hors domaine ne se règlent PAS ici : ils sont calibrés par
# scripts/calibrer_seuils.py et enregistrés dans backend/artefacts/seuils.json.
